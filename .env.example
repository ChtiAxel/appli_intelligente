# Copier ce fichier en .env puis remplir les valeurs.
# --- Base de données (MariaDB) ---
# En local (hors Docker) : DB_HOST=localhost et DB_PORT=3307 (port exposé par docker-compose)
# Dans Docker, docker-compose force DB_HOST=db et DB_PORT=3306.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=appia
DB_USER=appia
DB_PASSWORD=changeme

# Utilisateur MariaDB lecture seule stricte (requêtes générées par l'IA)
DB_READONLY_USER=natursql_readonly
DB_READONLY_PASSWORD=readonly_secret

# Limites de sécurité d'exécution des requêtes IA
DB_QUERY_TIMEOUT=3
DB_MAX_ROWS=50

# --- Ollama ---
# La génération SQL est sans plafond de tokens (num_predict=-1).
OLLAMA_BASE_URL=http://10.22.28.190:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
